{
  // Static site served by Cloudflare Workers Static Assets. `public/_headers` controls cache + security headers.
  "name": "distritogamer",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // Attaches the domains on deploy. Requires the distritogamer.com zone to be in the same Cloudflare account
  // (nameservers pointed at Cloudflare); Cloudflare creates the DNS records and certificates automatically.
  "routes": [
    { "pattern": "distritogamer.com", "custom_domain": true },
    { "pattern": "www.distritogamer.com", "custom_domain": true }
  ]
}
