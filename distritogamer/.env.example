# Public site URL (used for canonical URLs, sitemap, schema)
PUBLIC_SITE_URL=https://distritogamer.com

# Contact / forms. Leave endpoints empty to fall back to mailto links.
PUBLIC_CONTACT_EMAIL=info@christopherkunz.com
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_NEWSLETTER_ENDPOINT=

# Monetization + analytics (nothing loads until these are set AND the visitor accepts)
PUBLIC_ADSENSE_CLIENT=
PUBLIC_GA4_ID=

# Search Console / Bing verification tokens (meta tag content only)
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=

# Optional social profile URLs (only real, existing profiles)
PUBLIC_SOCIAL_X=
PUBLIC_SOCIAL_YOUTUBE=
PUBLIC_SOCIAL_REDDIT=

# Only used by `npm run images:pexels` (never commit a real key)
PEXELS_API_KEY=
