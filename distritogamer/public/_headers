# Cloudflare Workers static assets / Pages headers.
# Cloudflare MERGES values when several rules set the same header, so cache rules below are deliberately non-overlapping.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Fingerprinted build output, fonts and the versioned stylesheet: cache for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/global.css
  Cache-Control: public, max-age=31536000, immutable

# HTML: always revalidate
/
  Cache-Control: no-cache

/*/
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

# Everything else at the site root: one hour
/favicon.svg
  Cache-Control: public, max-age=3600

/logo.png
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/og-default.jpg
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap-*.xml
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600

/search-index.json
  Cache-Control: public, max-age=3600
