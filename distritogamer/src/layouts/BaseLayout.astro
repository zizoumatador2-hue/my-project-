---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import criticalCss from '../styles/critical.css?raw';
import { SITE } from '../config/site';
import { abs, jsonLd } from '../lib/utils';
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string; // canonical path, e.g. "/about/"
  image?: string; // absolute URL, 1200x630
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  schema?: unknown[];
  crumbs?: { name: string; href: string }[];
  published?: Date;
  modified?: Date;
  section?: string;
  rawTitle?: boolean;
}
const {
  title, description, path, image = abs('/og-default.jpg'), imageAlt = `${SITE.name}: ${SITE.tagline}`,
  type = 'website', noindex = false, keywords = [], schema = [], crumbs, published, modified, section, rawTitle = false,
} = Astro.props;

// Brand suffix only when it keeps the title within ~60 characters.
const branded = `${title} | ${SITE.name}`;
const fullTitle = rawTitle || title.includes(SITE.name) || branded.length > 60 ? title : branded;
const canonical = abs(path);
const ld = [...schema, ...(crumbs && crumbs.length > 1 ? [breadcrumbSchema(crumbs)] : [])];
const v = SITE.assetVersion;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0e17" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    {SITE.gscVerification && <meta name="google-site-verification" content={SITE.gscVerification} />}
    {SITE.bingVerification && <meta name="msvalidate.01" content={SITE.bingVerification} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-var.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={criticalCss}></style>
    <link rel="preload" as="style" href={`/global.css?v=${v}`} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={`/global.css?v=${v}`} /></noscript>
    <script is:inline>document.documentElement.classList.add('js')</script>
    {ld.map((o) => <script type="application/ld+json" set:html={jsonLd(o)} />)}
  </head>
  <body data-ga={SITE.ga4Id} data-ads={SITE.adsenseClient}>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    {crumbs && crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
    <main id="main"><slot /></main>
    <Footer />
    {(SITE.ga4Id || SITE.adsenseClient) && (
      <div class="consent" role="region" aria-label="Cookie preferences" data-consent hidden>
        <p>We use cookies for analytics and advertising only if you allow it. Essential features work without them. <a href="/privacy-policy/#cookies">Learn more</a>.</p>
        <div class="row">
          <button class="btn btn-primary" type="button" data-consent-accept>Accept</button>
          <button class="btn btn-ghost" type="button" data-consent-decline>Decline</button>
        </div>
      </div>
    )}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
