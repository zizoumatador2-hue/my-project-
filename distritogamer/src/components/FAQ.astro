---
interface Props { items: { q: string; a: string }[]; heading?: string; id?: string; }
const { items, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby={`${id}-h`} id={id}>
    <h2 id={`${id}-h`}>{heading}</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <div><p>{f.a}</p></div>
      </details>
    ))}
  </section>
)}
