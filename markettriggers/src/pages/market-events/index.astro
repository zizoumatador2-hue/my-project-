---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft && data.category === 'market-events');
const articles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout
  title="Upcoming U.S. Market Events Explained"
  description="Educational breakdowns of upcoming economic releases, Fed meetings, and market events — and why investors pay attention to them before they happen."
  canonicalPath="/market-events/"
>
  <div class="container" style="padding-top:32px;">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Market Events' }]} />
    <h1>Market Events</h1>
    <p class="hero__lede">
      Markets often move in anticipation of scheduled events, not just in reaction to them. These explainers cover upcoming economic releases and market events, and why they matter.
    </p>
  </div>
  <div class="container" style="padding-bottom:48px;">
    {articles.length > 0 ? (
      <div class="grid grid--3">
        {articles.map((entry) => (<ArticleCard entry={entry} categoryLabel="Market Events" />))}
      </div>
    ) : (
      <p style="color:var(--color-text-muted);">New explainers in this category are published weekly. Check back soon, or see our <a href="/">homepage guide</a> in the meantime.</p>
    )}
  </div>
</BaseLayout>
