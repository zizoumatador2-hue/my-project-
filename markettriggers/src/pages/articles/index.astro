---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const categoryLabels: Record<string, string> = {
  'economic-indicators': 'Economic Indicators',
  'stock-market-triggers': 'Stock Market Triggers',
  'market-sectors': 'Market Sectors',
  'investor-education': 'Investor Education',
  'market-events': 'Market Events',
};
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout
  title="All Articles: Market Triggers Explained"
  description="Every MarketTriggers.com explainer in one place: economic indicators, Fed policy, earnings, sector impact, and investor education for U.S. markets."
  canonicalPath="/articles/"
  noindex={articles.length === 0}
>
  <div class="container" style="padding:32px 20px 48px;">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'All Articles' }]} />
    <h1>All Articles</h1>
    <p class="hero__lede">Our full library of market trigger explainers, newest first. Subscribe via <a href="/rss.xml">RSS</a> to get new articles as they're published.</p>
    {articles.length > 0 ? (
      <div class="grid grid--3" style="margin-top:24px;">
        {articles.map((entry) => (<ArticleCard entry={entry} categoryLabel={categoryLabels[entry.data.category]} />))}
      </div>
    ) : (
      <p style="color:var(--color-text-muted);">New articles are on the way. Start with our <a href="/">complete guide to what moves the stock market</a>.</p>
    )}
  </div>
</BaseLayout>
