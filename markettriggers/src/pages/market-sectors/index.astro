---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft && data.category === 'market-sectors');
const articles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout
  title="U.S. Market Sectors Explained"
  description="How technology, financials, energy, healthcare, real estate, consumer, and industrial sectors respond differently to the same economic and market triggers."
  canonicalPath="/market-sectors/"
>
  <div class="container" style="padding-top:32px;">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Market Sectors' }]} />
    <h1>Market Sectors</h1>
    <p class="hero__lede">
      The same economic report can lift one sector and weigh on another. See how technology, financials, energy, healthcare, real estate, consumer, and industrial stocks each respond to market triggers.
    </p>
  </div>
  <div class="container" style="padding-bottom:48px;">
    {articles.length > 0 ? (
      <div class="grid grid--3">
        {articles.map((entry) => (<ArticleCard entry={entry} categoryLabel="Market Sectors" />))}
      </div>
    ) : (
      <p style="color:var(--color-text-muted);">New explainers in this category are published weekly. Check back soon, or see our <a href="/">homepage guide</a> in the meantime.</p>
    )}
  </div>
</BaseLayout>
