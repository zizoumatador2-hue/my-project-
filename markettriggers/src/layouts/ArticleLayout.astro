---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  publishDate: Date;
  modifiedDate?: Date;
  author: string;
  category: string;
  categoryLabel: string;
  categoryHref: string;
  faq?: { question: string; answer: string }[];
  image?: string;
  imageAlt?: string;
  toc?: { slug: string; text: string }[];
  readingMinutes?: number;
}

const {
  title,
  description,
  canonicalPath,
  publishDate,
  modifiedDate,
  author,
  categoryLabel,
  categoryHref,
  faq = [],
  image,
  imageAlt = '',
  toc = [],
  readingMinutes,
} = Astro.props;
const tocPlain = toc.some((h) => /^\d+[.)]/.test(h.text));
const imgUrl = image ? `https://markettriggers.com/images/${image}-1344.webp` : 'https://markettriggers.com/og-home.jpg';

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: [imgUrl],
  inLanguage: 'en-US',
  datePublished: publishDate.toISOString(),
  dateModified: (modifiedDate ?? publishDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'MarketTriggers.com',
    logo: { '@type': 'ImageObject', url: 'https://markettriggers.com/logo.png' },
  },
  mainEntityOfPage: new URL(canonicalPath, 'https://markettriggers.com').toString(),
};

const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const schema = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  type="article"
  publishDate={publishDate}
  modifiedDate={modifiedDate}
  schema={schema}
  image={image ? `/images/${image}-1344.webp` : '/og-home.jpg'}
  preloadImage={image ? { srcset: `/images/${image}-768.webp 768w, /images/${image}-1344.webp 1344w`, sizes: '(max-width: 800px) 100vw, 760px' } : undefined}
>
  <div class="disclaimer-strip">
    Educational content only, not personalized financial, investment, or trading advice.
  </div>
  <div class="article-header container">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: categoryLabel, href: categoryHref },
        { label: title },
      ]}
    />
    <h1 data-split>{title}</h1>
    <div class="article-meta">
      <span>By {author}</span>
      <span>Published <time datetime={publishDate.toISOString()}>{dateFmt(publishDate)}</time></span>
      {modifiedDate && (
        <span>Updated <time datetime={modifiedDate.toISOString()}>{dateFmt(modifiedDate)}</time></span>
      )}
      {readingMinutes && <span>{readingMinutes} min read</span>}
    </div>
  </div>

  <div class="container article-wrap">
      {image && (
        <figure class="photo article-figure">
          <img
            src={`/images/${image}-1344.webp`}
            srcset={`/images/${image}-768.webp 768w, /images/${image}-1344.webp 1344w`}
            sizes="(max-width: 800px) 100vw, 760px"
            width="1344"
            height="768"
            alt={imageAlt}
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}
      {toc.length > 2 && (
        <aside class="article-aside" aria-label="Table of contents">
        <details class={`article-toc${tocPlain ? ' article-toc--plain' : ''}`} open>
          <summary>In this article</summary>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </details>
        </aside>
      )}
    <article class="article-body">
      <slot />

      {faq.length > 0 && (
        <section aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently Asked Questions</h2>
          {faq.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
      )}

      <div class="author-box">
        <div class="author-box__avatar" aria-hidden="true">MT</div>
        <div>
          <strong>{author}</strong>
          <p style="margin:4px 0 0; font-size:0.9rem; color:var(--color-text-muted);">
            The MarketTriggers Editorial Team researches and writes original, source-checked explainers on the economic indicators and market events that move U.S. markets.
            <a href="/editorial-policy/">How we research and fact-check &rarr;</a>
          </p>
        </div>
      </div>
      <slot name="related" />
    </article>
  </div>
</BaseLayout>
