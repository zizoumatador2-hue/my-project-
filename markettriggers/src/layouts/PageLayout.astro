---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
  canonicalPath: string;
  updated?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, heading, description, canonicalPath, updated, schema } = Astro.props;
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} schema={schema}>
  <div class="container">
    <div class="article-body" style="padding-top:32px;">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: heading }]} />
      <h1>{heading}</h1>
      {updated && <p class="article-meta">Last updated: <time>{updated}</time></p>}
      <slot />
    </div>
  </div>
</BaseLayout>
