---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  modifiedDate?: Date;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  preloadImage?: { srcset: string; sizes: string };
}

const {
  title,
  description,
  canonicalPath,
  type,
  publishDate,
  modifiedDate,
  image,
  schema,
  noindex = false,
  preloadImage,
} = Astro.props;

const ADSENSE_CLIENT = 'ca-pub-8532224804732263';

const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <Seo
    title={title}
    description={description}
    canonicalPath={canonicalPath}
    type={type}
    publishDate={publishDate}
    modifiedDate={modifiedDate}
    image={image}
    noindex={noindex}
  />
  <meta name="theme-color" content="#0b3d91" />
  <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
  {preloadImage && (
    <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />
  )}

  <!-- Critical above-the-fold CSS -->
  <style is:inline>
    :root{--color-bg:#fff;--color-text:#15181c;--color-primary:#0b3d91}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:var(--color-text);background:var(--color-bg);line-height:1.6;font-size:16px}
    img,svg{max-width:100%;display:block}
    a{color:var(--color-primary);text-decoration:none}
    .container{max-width:1180px;margin:0 auto;padding:0 20px}
    .site-header{border-bottom:1px solid #e3e6ea;position:sticky;top:0;background:#fff;z-index:50}
    .site-header__inner{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;max-width:1180px;margin:0 auto}
    .brand{font-weight:700;font-size:1.35rem;color:#082b66}
    .progress-bar{position:fixed;top:0;left:0;right:0;height:3px;transform:scaleX(0)}
    .to-top{position:fixed;opacity:0;pointer-events:none}
    .skip-link{position:absolute;left:-9999px}
    .cookie-bar[hidden]{display:none}
    .hero--photo{position:relative;overflow:hidden;background:#0b1c3a;min-height:440px}
    .hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .nav-toggle{display:none}
    @media (max-width:860px){.main-nav{display:none}.nav-toggle{display:inline-block}}
  </style>

  <!-- Non-critical CSS, loaded async -->
  <link rel="preload" as="style" href="/global.css?v=8" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="/global.css?v=8" /></noscript>

  {schemaList.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- Consent Mode v2 defaults must run before the AdSense tag -->
  <script is:inline src="/consent-default.js"></script>
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
  <link rel="alternate" type="application/rss+xml" title="MarketTriggers.com" href="/rss.xml" />
  <script is:inline src="/effects.js?v=5" defer></script>
</head>
<body>
  <div class="progress-bar" aria-hidden="true"></div>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <button class="to-top" type="button" aria-label="Back to top">&uarr;</button>
  <div class="cookie-bar" id="cookie-bar" role="region" aria-label="Cookie choices" hidden>
    <p>We use cookies for traffic stats and ads. Allow personalized ads? <a href="/privacy-policy/">Privacy Policy</a></p>
    <div class="cookie-bar__actions">
      <button type="button" class="btn" data-consent="accept">Accept all</button>
      <button type="button" class="btn btn--ghost" data-consent="reject">Essential only</button>
    </div>
  </div>
</body>
</html>
