---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleCard from './ArticleCard.astro';
import { hubs } from '../data/hubs';

interface Props {
  slug: keyof typeof hubs;
}
const hub = hubs[Astro.props.slug];
const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === hub.slug))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const url = `https://markettriggers.com/${hub.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.title,
    description: hub.description,
    url,
    inLanguage: 'en-US',
    isPartOf: { '@type': 'WebSite', name: 'MarketTriggers.com', url: 'https://markettriggers.com/' },
    primaryImageOfPage: `https://markettriggers.com/images/${hub.image.slug}-1344.webp`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: hub.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
];
---
<BaseLayout
  title={hub.title}
  description={hub.description}
  canonicalPath={`/${hub.slug}/`}
  image={`/images/${hub.image.slug}-1344.webp`}
  schema={schema}
>
  <div class="container" style="padding-top:32px;">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: hub.label }]} />
    <h1>{hub.heading}</h1>
    <figure class="cat-hero">
      <img
        src={`/images/${hub.image.slug}-1344.webp`}
        srcset={`/images/${hub.image.slug}-768.webp 768w, /images/${hub.image.slug}-1344.webp 1344w`}
        sizes="(max-width: 1180px) 100vw, 1140px"
        width="1344"
        height="768"
        alt={hub.image.alt}
        fetchpriority="high"
        decoding="async"
      />
    </figure>
    <div class="hub-intro">
      {hub.intro.map((p) => <p>{p}</p>)}
    </div>

    <section aria-labelledby="topics-heading">
      <h2 id="topics-heading">Key topics in {hub.label.toLowerCase()}</h2>
      <div class="hub-topics">
        {hub.topics.map((t) => (
          <a href={t.href} class="card" draggable="false">
            <h3 class="card__title">{t.title}</h3>
            <p style="margin:0; font-size:.93rem; color:var(--color-text-muted);">{t.blurb}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="hub-intro" aria-labelledby="watch-heading">
      <h2 id="watch-heading">What to watch</h2>
      <ul>
        {hub.watch.map((w) => <li>{w}</li>)}
      </ul>
    </section>

    {articles.length > 0 && (
      <section aria-labelledby="latest-heading">
        <h2 id="latest-heading">Latest {hub.label.toLowerCase()} articles</h2>
        <div class="grid grid--3">
          {articles.map((entry) => <ArticleCard entry={entry} categoryLabel={hub.label} />)}
        </div>
      </section>
    )}

    <section class="hub-intro" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Frequently asked questions</h2>
      {hub.faq.map((f) => (
        <details class="faq-item">
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </section>

    <section class="hub-intro" aria-labelledby="sources-heading" style="padding-bottom:48px;">
      <h2 id="sources-heading">Official sources</h2>
      <ul>
        {hub.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>)}
      </ul>
      <p>For the full picture, read our <a href="/">complete guide to what moves the stock market</a>.</p>
    </section>
  </div>
</BaseLayout>
