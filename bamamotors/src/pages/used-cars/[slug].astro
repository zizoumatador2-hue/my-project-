---
import LandingPage from '../../components/LandingPage.astro';
import { resolveLanding } from '../../lib/landing';
const landing = await resolveLanding(Astro.locals.runtime.env.DB, String(Astro.params.slug ?? '').toLowerCase());
if (!landing) return Astro.rewrite('/404');
---
<LandingPage landing={landing} />
