---
import ContentLayout from '../layouts/ContentLayout.astro';
import { z } from 'zod';
import { insert } from '../lib/db';
import { clientIp, rateLimit, verifyTurnstile } from '../lib/security';
import { notifyAdmins, sendEmail } from '../lib/email';
import { formToObject, zodErrors, emailSchema, type FieldErrors } from '../lib/validation';

const env = Astro.locals.runtime.env;
const s = Astro.locals.settings;
const schema = z.object({
  name: z.string().trim().min(2, 'Enter your name').max(120),
  email: emailSchema,
  subject: z.enum(['general', 'dealer', 'listing', 'privacy', 'press']),
  message: z.string().trim().min(10, 'Please write at least 10 characters').max(5000),
});
let errors: FieldErrors = {};
let values: Record<string, string> = { name: Astro.locals.user?.name ?? '', email: Astro.locals.user?.email ?? '' };
let sent = false;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  values = formToObject(fd);
  const ip = clientIp(Astro.request);
  if (values.website) sent = true;
  else if (!(await rateLimit(env.DB, `contact:${ip}`, 5, 3600))) errors._ = 'Too many messages. Please try again later.';
  else if (!(await verifyTurnstile(env, values['cf-turnstile-response'] ?? null, ip))) errors._ = 'Please complete the verification challenge.';
  else {
    const p = schema.safeParse(values);
    if (!p.success) errors = zodErrors(p.error);
    else {
      await insert(env.DB, 'INSERT INTO contact_messages (name, email, subject, message) VALUES (?,?,?,?)', [p.data.name, p.data.email, p.data.subject, p.data.message]);
      await notifyAdmins(env.DB, 'New contact message', `${p.data.name}: ${p.data.subject}`, '/admin/messages');
      if (s.contact_email) await sendEmail(env, s.contact_email, `[BamaMotors contact] ${p.data.subject}, ${p.data.name}`, `From: ${p.data.name} <${p.data.email}>\n\n${p.data.message}`);
      sent = true;
    }
  }
}
const subjects = [['general', 'General question'], ['dealer', 'Dealer sales & plans'], ['listing', 'Report a listing'], ['privacy', 'Privacy request'], ['press', 'Press & partnerships']];
---
<ContentLayout title="Contact BamaMotors" h1="Contact us" path="/contact" description="Contact the BamaMotors team with questions about searching used cars in Alabama, dealer plans, listings or privacy requests.">
  <div class="vd-layout">
    <div>
      {sent ? <div class="alert alert-ok" role="status">Thanks. Your message was sent, and we'll reply to the email address you gave.</div> : (
        <form method="post" class="card card-pad" novalidate>
          {errors._ && <div class="alert alert-err" role="alert">{errors._}</div>}
          <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="form-grid">
            <div class="field"><label for="c-name">Name</label><input class="input" id="c-name" name="name" required autocomplete="name" value={values.name} aria-invalid={errors.name ? 'true' : undefined} />{errors.name && <span class="field-error">{errors.name}</span>}</div>
            <div class="field"><label for="c-email">Email</label><input class="input" id="c-email" name="email" type="email" required autocomplete="email" value={values.email} aria-invalid={errors.email ? 'true' : undefined} />{errors.email && <span class="field-error">{errors.email}</span>}</div>
            <div class="field full"><label for="c-subject">Topic</label><select class="select" id="c-subject" name="subject">{subjects.map(([v, l]) => <option value={v} selected={values.subject === v}>{l}</option>)}</select></div>
            <div class="field full"><label for="c-message">Message</label><textarea class="textarea" id="c-message" name="message" required rows="6" aria-invalid={errors.message ? 'true' : undefined}>{values.message ?? ''}</textarea>{errors.message && <span class="field-error">{errors.message}</span>}</div>
          </div>
          {env.TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} style="margin-top:12px"></div>}
          <button class="btn btn-primary btn-lg" type="submit" style="margin-top:14px">Send message</button>
        </form>
      )}
    </div>
    <aside class="vd-aside" aria-label="Other ways to reach us">
      <div class="card card-pad">
        <h2 style="font-size:1.1rem">Other ways to reach us</h2>
        {s.contact_email && <p><strong>Email:</strong> <a href={`mailto:${s.contact_email}`}>{s.contact_email}</a></p>}
        {s.contact_phone && <p><strong>Phone:</strong> <a href={`tel:${s.contact_phone.replace(/[^\d+]/g, '')}`}>{s.contact_phone}</a></p>}
        <p class="small muted">Questions about a specific vehicle? Please contact the dealer directly from the listing. They have the most accurate information.</p>
        <p class="small"><a href="/faq">Read the FAQ</a></p>
      </div>
    </aside>
  </div>
  {env.TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</ContentLayout>
