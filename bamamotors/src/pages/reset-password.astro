---
import BaseLayout from '../layouts/BaseLayout.astro';
import { first, run, nowIso } from '../lib/db';
import { hashPassword, sha256Hex } from '../lib/crypto';
import { destroyAllSessions } from '../lib/auth';
import { passwordSchema } from '../lib/validation';

const env = Astro.locals.runtime.env;
const token = Astro.url.searchParams.get('token') ?? '';
const id = token.length >= 20 && token.length <= 100 ? await sha256Hex(token) : '';
const reset = id ? await first<{ id: string; user_id: number; expires_at: string; used_at: string | null }>(env.DB, 'SELECT * FROM password_resets WHERE id = ?', [id]) : null;
const valid = !!reset && !reset.used_at && reset.expires_at > nowIso();
let error = '';
if (valid && Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const pw = String(fd.get('password') ?? '');
  const parsed = passwordSchema.safeParse(pw);
  if (!parsed.success) error = parsed.error.issues[0].message;
  else if (pw !== String(fd.get('confirm') ?? '')) error = 'Passwords do not match.';
  else {
    await run(env.DB, 'UPDATE users SET password_hash = ?, updated_at = ? WHERE id = ?', [await hashPassword(pw), nowIso(), reset!.user_id]);
    await run(env.DB, 'UPDATE password_resets SET used_at = ? WHERE id = ?', [nowIso(), id]);
    await destroyAllSessions(env.DB, reset!.user_id);
    return Astro.redirect('/login?ok=reset', 303);
  }
}
---
<BaseLayout title="Choose a new password" description="Choose a new BamaMotors password." noindex>
  <div class="wrap" style="max-width:460px;padding:40px 16px 64px">
    <h1>Choose a new password</h1>
    {!valid ? (
      <div class="alert alert-err" role="alert">This reset link is invalid or has expired. <a href="/forgot-password">Request a new one</a>.</div>
    ) : (
      <form method="post" class="card card-pad stack">
        {error && <div class="alert alert-err" role="alert">{error}</div>}
        <div class="field"><label for="password">New password</label><input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength="10" required /></div>
        <div class="field"><label for="confirm">Confirm password</label><input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="10" required /></div>
        <button class="btn btn-primary btn-block" type="submit">Save new password</button>
      </form>
    )}
  </div>
</BaseLayout>
