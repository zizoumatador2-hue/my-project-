---
import BaseLayout from '../layouts/BaseLayout.astro';
import { first, run, addDays } from '../lib/db';
import { randomToken, sha256Hex } from '../lib/crypto';
import { sendEmail } from '../lib/email';
import { clientIp, rateLimit } from '../lib/security';
import { emailSchema } from '../lib/validation';

const env = Astro.locals.runtime.env;
let done = false;
let error = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const email = String(fd.get('email') ?? '').trim().toLowerCase();
  if (!emailSchema.safeParse(email).success) error = 'Enter a valid email address.';
  else if (!(await rateLimit(env.DB, `reset:${clientIp(Astro.request)}`, 5, 3600))) error = 'Too many requests. Please try again later.';
  else {
    const u = await first<{ id: number; name: string }>(env.DB, "SELECT id, name FROM users WHERE email = ? AND status = 'active' AND password_hash LIKE 'pbkdf2$%'", [email]);
    if (u) {
      const token = randomToken(32);
      await run(env.DB, 'INSERT INTO password_resets (id, user_id, expires_at) VALUES (?,?,?)', [await sha256Hex(token), u.id, addDays(1 / 24)]);
      const link = `${env.SITE_URL.replace(/\/$/, '')}/reset-password?token=${token}`;
      await sendEmail(env, email, 'Reset your BamaMotors password', `Hi ${u.name},\n\nUse this link within 1 hour to choose a new password:\n${link}\n\nIf you didn't request this, you can ignore this email.\n\n— BamaMotors`);
    }
    done = true; // Same response whether or not the account exists (no account enumeration).
  }
}
---
<BaseLayout title="Reset your password" description="Reset your BamaMotors password." noindex>
  <div class="wrap" style="max-width:460px;padding:40px 16px 64px">
    <h1>Reset your password</h1>
    {done ? (
      <div class="alert alert-ok" role="status">If an account exists for that email, we've sent a reset link. It expires in 1 hour.</div>
    ) : (
      <form method="post" class="card card-pad stack">
        {error && <div class="alert alert-err" role="alert">{error}</div>}
        <p class="muted" style="margin:0">Enter your account email and we'll send you a link to choose a new password.</p>
        <div class="field"><label for="email">Email</label><input class="input" id="email" name="email" type="email" autocomplete="email" required /></div>
        <button class="btn btn-primary btn-block" type="submit">Send reset link</button>
      </form>
    )}
    <p class="center" style="margin-top:16px"><a href="/login">Back to sign in</a></p>
  </div>
</BaseLayout>
