---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { all, first, run, audit } from '../../lib/db';
import { formatDate } from '../../lib/format';

const db = Astro.locals.runtime.env.DB;
const admin = Astro.locals.user!;
let err: string | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const id = Number(fd.get('user_id'));
  const action = String(fd.get('action'));
  const target = await first<{ id: number; role: string }>(db, 'SELECT id, role FROM users WHERE id = ?', [id]);
  if (!target) err = 'User not found.';
  else if (target.id === admin.id) err = 'You cannot change your own account here.';
  else if (action === 'suspend' || action === 'activate') {
    await run(db, 'UPDATE users SET status = ? WHERE id = ?', [action === 'suspend' ? 'suspended' : 'active', id]);
    if (action === 'suspend') await run(db, 'DELETE FROM sessions WHERE user_id = ?', [id]);
  } else if (action === 'role') {
    const role = String(fd.get('role'));
    const hasDealer = await first(db, 'SELECT id FROM dealers WHERE owner_user_id = ?', [id]);
    if (!['consumer', 'admin', 'dealer'].includes(role)) err = 'Invalid role.';
    else if (role === 'dealer' && !hasDealer) err = 'This user has no dealership. Dealers sign up through the dealer registration form.';
    else await run(db, 'UPDATE users SET role = ? WHERE id = ?', [role, id]);
  } else if (action === 'delete') {
    await run(db, 'DELETE FROM users WHERE id = ?', [id]);
  }
  if (!err) { await audit(db, admin.id, `user.${action}`, 'user', id); return Astro.redirect(`/admin/users${Astro.url.search}${Astro.url.search ? '&' : '?'}ok=updated`, 303); }
}
const sp = Astro.url.searchParams;
const q = (sp.get('q') ?? '').trim().slice(0, 60);
const role = ['consumer', 'dealer', 'admin'].includes(sp.get('role') ?? '') ? sp.get('role')! : '';
const page = Math.max(1, Number(sp.get('page')) || 1);
const PER = 40;
const where = ["password_hash LIKE 'pbkdf2$%'"];
const params: (string | number)[] = [];
if (q) { where.push('(email LIKE ? OR name LIKE ?)'); params.push(`%${q}%`, `%${q}%`); }
if (role) { where.push('role = ?'); params.push(role); }
const total = (await first<{ n: number }>(db, `SELECT COUNT(*) AS n FROM users WHERE ${where.join(' AND ')}`, params))?.n ?? 0;
const users = await all<{ id: number; email: string; name: string; role: string; status: string; created_at: string; last_login_at: string | null }>(db,
  `SELECT id, email, name, role, status, created_at, last_login_at FROM users WHERE ${where.join(' AND ')} ORDER BY created_at DESC LIMIT ${PER} OFFSET ${(page - 1) * PER}`, params);
---
<DashboardLayout title="Users" area="admin" err={err}>
  <h1>Users</h1>
  <form method="get" class="toolbar">
    <div class="field"><label for="q">Search</label><input class="input" id="q" name="q" value={q} placeholder="Email or name" /></div>
    <div class="field"><label for="r">Role</label><select class="select" id="r" name="role"><option value="">All</option>{['consumer', 'dealer', 'admin'].map((x) => <option selected={x === role}>{x}</option>)}</select></div>
    <button class="btn btn-outline" type="submit">Filter</button>
  </form>
  <p class="muted">{total} users</p>
  <div class="table-wrap"><table>
    <thead><tr><th>User</th><th>Role</th><th>Status</th><th>Joined</th><th>Last login</th><th>Actions</th></tr></thead>
    <tbody>{users.map((u) => (
      <tr><td><strong>{u.name}</strong><br /><span class="small muted">{u.email}</span></td>
        <td><form method="post" class="row" style="flex-wrap:nowrap"><input type="hidden" name="user_id" value={u.id} /><input type="hidden" name="action" value="role" />
          <select class="select" name="role" style="min-height:36px;width:auto" aria-label={`Role for ${u.email}`}>{['consumer', 'dealer', 'admin'].map((x) => <option selected={x === u.role}>{x}</option>)}</select>
          <button class="btn btn-ghost btn-sm" type="submit">Set</button></form></td>
        <td><span class={`badge ${u.status === 'active' ? 'badge-ok' : 'badge-err'}`}>{u.status}</span></td>
        <td class="small">{formatDate(u.created_at)}</td><td class="small">{u.last_login_at ? formatDate(u.last_login_at) : '—'}</td>
        <td style="white-space:nowrap">
          <form method="post" class="inline-form"><input type="hidden" name="user_id" value={u.id} /><button class="btn btn-ghost btn-sm" name="action" value={u.status === 'active' ? 'suspend' : 'activate'}>{u.status === 'active' ? 'Suspend' : 'Activate'}</button></form>
          <form method="post" class="inline-form" data-confirm={`Delete ${u.email}? Dealer accounts delete their dealership and inventory too.`}><input type="hidden" name="user_id" value={u.id} /><button class="btn btn-danger btn-sm" name="action" value="delete">Delete</button></form>
        </td></tr>
    ))}</tbody>
  </table></div>
  <Pagination page={page} pages={Math.max(1, Math.ceil(total / PER))} href={(p) => `/admin/users?${new URLSearchParams({ ...(q && { q }), ...(role && { role }), page: String(p) })}`} />
</DashboardLayout>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) => f.addEventListener('submit', (e) => { if (!confirm(f.dataset.confirm!)) e.preventDefault(); }));
</script>
