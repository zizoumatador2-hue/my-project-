---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { all, first } from '../../lib/db';
import { formatPrice, formatNumber } from '../../lib/format';
import { LEAD_TYPES, type LeadType } from '../../lib/constants';

const db = Astro.locals.runtime.env.DB;
const days = [7, 30, 90].includes(Number(Astro.url.searchParams.get('days'))) ? Number(Astro.url.searchParams.get('days')) : 30;
const since = new Date(Date.now() - days * 86400000).toISOString();
const [leadTypes, leadStatus, perDay, topDealers, topVehicles, cities, revenue, signups, views] = await Promise.all([
  all<{ type: LeadType; n: number }>(db, 'SELECT type, COUNT(*) AS n FROM leads WHERE created_at >= ? GROUP BY type ORDER BY n DESC', [since]),
  all<{ status: string; n: number }>(db, 'SELECT status, COUNT(*) AS n FROM leads WHERE created_at >= ? GROUP BY status', [since]),
  all<{ day: string; n: number }>(db, 'SELECT substr(created_at,1,10) AS day, COUNT(*) AS n FROM leads WHERE created_at >= ? GROUP BY day ORDER BY day', [since]),
  all<{ id: number; name: string; leads: number; vehicles: number }>(db, "SELECT d.id, d.name, COUNT(l.id) AS leads, (SELECT COUNT(*) FROM vehicles v WHERE v.dealer_id = d.id AND v.status = 'active') AS vehicles FROM dealers d LEFT JOIN leads l ON l.dealer_id = d.id AND l.created_at >= ? GROUP BY d.id ORDER BY leads DESC LIMIT 10", [since]),
  all<{ id: number; title: string; views: number; leads: number }>(db, "SELECT v.id, v.year || ' ' || mk.name || ' ' || md.name AS title, COALESCE((SELECT SUM(views) FROM vehicle_view_stats s WHERE s.vehicle_id = v.id AND s.day >= ?),0) AS views, (SELECT COUNT(*) FROM leads l WHERE l.vehicle_id = v.id AND l.created_at >= ?) AS leads FROM vehicles v JOIN makes mk ON mk.id = v.make_id JOIN models md ON md.id = v.model_id ORDER BY views DESC LIMIT 10", [since.slice(0, 10), since]),
  all<{ name: string; n: number }>(db, "SELECT COALESCE(c.name, v.city_name) AS name, COUNT(*) AS n FROM vehicles v LEFT JOIN cities c ON c.id = v.city_id WHERE v.status = 'active' GROUP BY name ORDER BY n DESC LIMIT 12"),
  first<{ total: number; subs: number; featured: number }>(db, "SELECT COALESCE(SUM(amount_cents),0) AS total, COALESCE(SUM(CASE WHEN kind='subscription' THEN amount_cents END),0) AS subs, COALESCE(SUM(CASE WHEN kind='featured' THEN amount_cents END),0) AS featured FROM payments WHERE status = 'succeeded' AND created_at >= ?", [since]),
  first<{ consumers: number; dealers: number }>(db, "SELECT SUM(role = 'consumer') AS consumers, SUM(role = 'dealer') AS dealers FROM users WHERE created_at >= ?", [since]),
  first<{ n: number }>(db, 'SELECT COALESCE(SUM(views),0) AS n FROM vehicle_view_stats WHERE day >= ?', [since.slice(0, 10)]),
]);
const totalLeads = leadTypes.reduce((a, t) => a + t.n, 0);
const max = Math.max(1, ...perDay.map((d) => d.n));
const csvRows = [['Dealer', 'Leads', 'Active vehicles'], ...topDealers.map((d) => [d.name, d.leads, d.vehicles])];
const csv = `data:text/csv;charset=utf-8,${encodeURIComponent(csvRows.map((r) => r.map((c) => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n'))}`;
---
<DashboardLayout title="Reports" area="admin">
  <div class="spread"><h1 style="margin:0">Reports</h1>
    <ul class="chips">{[7, 30, 90].map((d) => <li><a class="chip" href={`/admin/reports?days=${d}`} aria-current={d === days ? 'page' : undefined}>Last {d} days</a></li>)}</ul></div>
  <div class="grid grid-4" style="margin-top:16px">
    <div class="stat"><div class="n">{totalLeads}</div><div class="l">Leads</div></div>
    <div class="stat"><div class="n">{formatNumber(views?.n ?? 0)}</div><div class="l">Vehicle page views</div></div>
    <div class="stat"><div class="n">{views?.n ? `${((totalLeads / views.n) * 100).toFixed(1)}%` : '—'}</div><div class="l">Lead conversion rate</div></div>
    <div class="stat"><div class="n">{formatPrice(revenue?.total ?? 0)}</div><div class="l">Revenue (subs {formatPrice(revenue?.subs ?? 0)} · featured {formatPrice(revenue?.featured ?? 0)})</div></div>
    <div class="stat"><div class="n">{signups?.consumers ?? 0}</div><div class="l">New shopper accounts</div></div>
    <div class="stat"><div class="n">{signups?.dealers ?? 0}</div><div class="l">New dealer accounts</div></div>
  </div>
  <section class="panel" style="margin-top:20px"><h2 style="font-size:1.1rem">Leads per day</h2>
    <div class="bars" role="img" aria-label="Leads per day">{perDay.map((d) => <span style={`height:${(d.n / max) * 100}%`} title={`${d.day}: ${d.n}`}></span>)}</div></section>
  <div class="grid grid-2" style="margin-top:20px;align-items:start">
    <section class="panel"><h2 style="font-size:1.1rem">Leads by type</h2><div class="table-wrap"><table><tbody>{leadTypes.map((t) => <tr><td>{LEAD_TYPES[t.type]}</td><td>{t.n}</td></tr>)}</tbody></table></div></section>
    <section class="panel"><h2 style="font-size:1.1rem">Leads by status</h2><div class="table-wrap"><table><tbody>{leadStatus.map((t) => <tr><td>{t.status}</td><td>{t.n}</td></tr>)}</tbody></table></div></section>
    <section class="panel"><div class="spread"><h2 style="font-size:1.1rem;margin:0">Top dealers by leads</h2><a class="small" href={csv} download={`dealers-${days}d.csv`}>Export CSV</a></div><div class="table-wrap" style="margin-top:8px"><table><thead><tr><th>Dealer</th><th>Leads</th><th>Vehicles</th></tr></thead><tbody>{topDealers.map((d) => <tr><td><a href={`/admin/dealers/${d.id}`}>{d.name}</a></td><td>{d.leads}</td><td>{d.vehicles}</td></tr>)}</tbody></table></div></section>
    <section class="panel"><h2 style="font-size:1.1rem">Top vehicles by views</h2><div class="table-wrap"><table><thead><tr><th>Vehicle</th><th>Views</th><th>Leads</th></tr></thead><tbody>{topVehicles.map((v) => <tr><td><a href={`/admin/vehicles/${v.id}`}>{v.title}</a></td><td>{v.views}</td><td>{v.leads}</td></tr>)}</tbody></table></div></section>
    <section class="panel"><h2 style="font-size:1.1rem">Active inventory by city</h2><div class="table-wrap"><table><tbody>{cities.map((c) => <tr><td>{c.name}</td><td>{c.n}</td></tr>)}</tbody></table></div></section>
  </div>
</DashboardLayout>
