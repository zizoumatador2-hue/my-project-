---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DealerSignupForm from '../components/DealerSignupForm.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { PLANS } from '../lib/plans';
import { formatPrice } from '../lib/format';
import { breadcrumbLd, faqLd } from '../lib/seo';
import Photo from '../components/Photo.astro';
import { image } from '../lib/images';

const env = Astro.locals.runtime.env;
const user = Astro.locals.user;
const s = Astro.locals.settings;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'For Dealers', href: '/for-dealers' }];
const heroImg = image('page-for-dealers');
const featuredPrice = formatPrice(Number(s.featured_price_cents || 2900));
const faq = [
  { q: 'How much does it cost to list vehicles on BamaMotors?', a: `The Free plan includes up to ${PLANS.free.vehicleLimit} active vehicles. Basic is ${formatPrice(PLANS.basic.priceCents)}/month for up to ${PLANS.basic.vehicleLimit} vehicles, and Pro is ${formatPrice(PLANS.pro.priceCents)}/month for up to ${PLANS.pro.vehicleLimit}.` },
  { q: 'Do you charge per lead?', a: 'No. Leads are included on every plan, including Free. Shoppers contact you directly and you own the relationship.' },
  { q: 'What is a featured listing?', a: `Featured vehicles appear first in search results and on the homepage. Basic and Pro include featured slots, and individual vehicles can be featured for ${featuredPrice} per ${s.featured_days || 30} days.` },
  { q: 'How are dealers verified?', a: 'Our team reviews every new dealership account before its listings go live. We may contact you to confirm your business details.' },
  { q: 'Can I import my inventory automatically?', a: 'Today vehicles are added from your dashboard. Our platform is designed to accept licensed inventory feeds. Contact us if you want to connect your DMS or feed provider.' },
];
---
<BaseLayout title="List Your Dealership: Reach Alabama Car Buyers" ogImage={heroImg?.src} description="Alabama car dealers: list your used car inventory on BamaMotors, get local leads by email, and grow with Basic and Pro plans. Start free with up to 10 vehicles."
  keywords="car dealer advertising Alabama, list used cars Alabama, auto dealer leads Alabama, dealer listings Alabama" canonical="/for-dealers" jsonLd={[breadcrumbLd(env.SITE_URL, crumbs), faqLd(faq)]}>
  <section class="hero">
    {heroImg && <div class="hero-photo" aria-hidden="true"><Photo img={heroImg} sizes="100vw" eager alt="" /></div>}
    <div class="wrap">
      <Breadcrumbs crumbs={crumbs} />
      <h1 style="margin-top:12px">Sell more cars to Alabama shoppers</h1>
      <p class="lead">BamaMotors is a local marketplace built for Alabama dealerships. List your inventory, show up in local city searches, and receive leads straight to your inbox.</p>
      <div class="row" style="margin-top:20px">
        <a class="btn btn-primary btn-lg" href="#signup">List Your Dealership</a>
        <a class="btn btn-outline btn-lg" href="#pricing">See pricing</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap grid grid-3">
      <div class="panel"><Icon name="pin" size={28} /><h2 style="font-size:1.15rem;margin-top:8px">Local search visibility</h2><p class="muted" style="margin:0">Your vehicles appear on city pages like “used cars in Birmingham” and in ZIP-code radius searches.</p></div>
      <div class="panel"><Icon name="inbox" size={28} /><h2 style="font-size:1.15rem;margin-top:8px">Leads without the middleman</h2><p class="muted" style="margin:0">Contact, price, test-drive and financing requests go straight to you. Manage them in one dashboard.</p></div>
      <div class="panel"><Icon name="chart" size={28} /><h2 style="font-size:1.15rem;margin-top:8px">Simple analytics</h2><p class="muted" style="margin:0">See views, saves and leads for each vehicle so you know what's working.</p></div>
    </div>
  </section>
  <section class="section band" id="pricing" aria-labelledby="pricing-title">
    <div class="wrap">
      <h2 id="pricing-title" class="center">Simple, transparent pricing</h2>
      <p class="center muted">No setup fees. No per-lead charges. Cancel anytime.</p>
      <div class="grid grid-3" style="margin-top:20px">
        {Object.values(PLANS).map((p) => (
          <div class={`plan spotlight${p.id === 'basic' ? ' popular star-border' : ''}`}>
            {p.id === 'basic' && <span class="badge badge-featured" style="align-self:flex-start">Most popular</span>}
            <h3 style="margin:0">{p.name}</h3>
            <div class="price">{p.priceCents ? formatPrice(p.priceCents) : '$0'}<span class="small muted">/month</span></div>
            <ul>{p.perks.map((perk) => <li>{perk}</li>)}</ul>
            <a class={`btn ${p.id === 'basic' ? 'btn-primary' : 'btn-outline'} btn-block`} href={user?.role === 'dealer' ? '/dashboard/billing' : '#signup'}>{p.id === 'free' ? 'Start free' : `Choose ${p.name}`}</a>
          </div>
        ))}
      </div>
      <p class="center small muted" style="margin-top:16px">Featured listings: {featuredPrice} per vehicle for {s.featured_days || 30} days. Prices in USD.</p>
    </div>
  </section>
  <section class="section" id="signup" aria-labelledby="signup-title">
    <div class="wrap" style="max-width:780px">
      <h2 id="signup-title">Create your dealer account</h2>
      {user ? (
        <div class="alert alert-info">You're signed in as {user.email}. {user.role === 'dealer' ? <a href="/dashboard">Go to your dealer dashboard</a> : <>Dealer accounts use a separate login. <a href="/contact">Contact us</a> to convert this account, or sign out and register your dealership.</>}</div>
      ) : <DealerSignupForm action="/signup?type=dealer" />}
    </div>
  </section>
  <section class="section band"><div class="wrap" style="max-width:900px"><Faq faq={faq} title="Dealer FAQ" /></div></section>
</BaseLayout>
