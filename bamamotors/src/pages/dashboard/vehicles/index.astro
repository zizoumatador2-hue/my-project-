---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Pagination from '../../../components/Pagination.astro';
import { all, first, nowIso } from '../../../lib/db';
import { formatPrice, formatNumber } from '../../../lib/format';
import { planOf } from '../../../lib/plans';
import { activeVehicleCount } from '../../../lib/dealers';
import { featureVehicle, unfeatureVehicle, planFeaturedAvailable, createFeaturedCheckout, CHECKOUT_ERROR } from '../../../lib/billing';
import { stripeEnabled } from '../../../lib/stripe';
import { deleteVehicle } from '../../../lib/vehicle-save';
import { notifyAdmins } from '../../../lib/email';
import { VEHICLE_STATUSES, isVehicleStatus } from '../../../lib/constants';

const env = Astro.locals.runtime.env;
const db = env.DB;
const dealer = Astro.locals.dealer!;
const user = Astro.locals.user!;
const s = Astro.locals.settings;
const plan = planOf(dealer.plan);
let err = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') ?? '');
  const ids = fd.getAll('ids').map(Number).filter((n) => Number.isInteger(n) && n > 0).slice(0, 200);
  const own = ids.length ? (await all<{ id: number; status: string }>(db, `SELECT id, status FROM vehicles WHERE dealer_id = ? AND id IN (${ids.map(() => '?').join(',')})`, [dealer.id, ...ids])) : [];
  const vid = Number(fd.get('vehicle_id'));
  const target = vid ? await first<{ id: number; status: string }>(db, 'SELECT id, status FROM vehicles WHERE id = ? AND dealer_id = ?', [vid, dealer.id]) : null;
  if (action === 'bulk_status') {
    const status = String(fd.get('status'));
    if (isVehicleStatus(status) && own.length) {
      if (status === 'active' || status === 'draft') {
        const used = await activeVehicleCount(db, dealer.id);
        const adding = own.filter((o) => o.status !== 'active' && o.status !== 'draft').length;
        if (used + adding > plan.vehicleLimit) err = `That would exceed your plan limit of ${plan.vehicleLimit} listings.`;
      }
      if (!err) {
        await db.batch(own.map((o) => db.prepare('UPDATE vehicles SET status = ?, updated_at = ? WHERE id = ?').bind(status, nowIso(), o.id)));
        if (status !== 'active') for (const o of own) await unfeatureVehicle(db, o.id);
        return Astro.redirect('/dashboard/vehicles?ok=bulk', 303);
      }
    }
  } else if (action === 'bulk_delete' && own.length) {
    for (const o of own) await deleteVehicle(db, env.MEDIA, o.id, user.id);
    return Astro.redirect('/dashboard/vehicles?ok=deleted', 303);
  } else if (action === 'feature' && target) {
    if (target.status !== 'active') err = 'Only active vehicles can be featured.';
    else if ((await planFeaturedAvailable(db, dealer)) <= 0) err = 'No featured slots left on your plan.';
    else { await featureVehicle(db, target.id, dealer.id, 30, 'plan'); return Astro.redirect('/dashboard/vehicles?ok=featured', 303); }
  } else if (action === 'unfeature' && target) {
    await unfeatureVehicle(db, target.id);
    return Astro.redirect('/dashboard/vehicles?ok=featured', 303);
  } else if (action === 'buy_featured' && target) {
    if (target.status !== 'active') err = 'Only active vehicles can be featured.';
    else if (stripeEnabled(env)) {
      try { return Astro.redirect(await createFeaturedCheckout(env, dealer, target.id, Number(s.featured_price_cents || 2900), Number(s.featured_days || 30)), 303); }
      catch (e) { console.error('featured checkout failed', e); err = CHECKOUT_ERROR; }
    } else {
      await notifyAdmins(db, 'Featured listing requested', `${dealer.name} requested featuring vehicle #${target.id}`, `/admin/featured?vehicle=${target.id}`);
      return Astro.redirect('/dashboard/vehicles?ok=requested', 303);
    }
  }
  if (!err && !['bulk_status', 'bulk_delete', 'feature', 'unfeature', 'buy_featured'].includes(action)) err = 'Unknown action.';
  if (!err && !own.length && action.startsWith('bulk')) err = 'Select at least one vehicle.';
}
const statusParam = Astro.url.searchParams.get('status');
const status = isVehicleStatus(statusParam) ? statusParam : '';
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const PER = 25;
const where = ['v.dealer_id = ?'];
const params: (string | number)[] = [dealer.id];
if (status) { where.push('v.status = ?'); params.push(status); }
if (q) { where.push("(mk.name || ' ' || md.name || ' ' || COALESCE(v.trim,'') || ' ' || COALESCE(v.vin,'') || ' ' || COALESCE(v.stock_number,'') || ' ' || v.year) LIKE ?"); params.push(`%${q}%`); }
const from = `FROM vehicles v JOIN makes mk ON mk.id = v.make_id JOIN models md ON md.id = v.model_id WHERE ${where.join(' AND ')}`;
const total = (await first<{ n: number }>(db, `SELECT COUNT(*) AS n ${from}`, params))?.n ?? 0;
const rows = await all<{ id: number; slug: string; year: number; make: string; model: string; trim: string | null; price_cents: number; mileage: number; status: string; views: number; featured_until: string | null; leads: number; img: string | null; stock_number: string | null }>(db,
  `SELECT v.id, v.slug, v.year, mk.name AS make, md.name AS model, v.trim, v.price_cents, v.mileage, v.status, v.views, v.featured_until, v.stock_number,
     (SELECT COUNT(*) FROM leads l WHERE l.vehicle_id = v.id) AS leads,
     (SELECT key_small FROM vehicle_images vi WHERE vi.vehicle_id = v.id ORDER BY position, id LIMIT 1) AS img
   ${from} ORDER BY v.updated_at DESC LIMIT ${PER} OFFSET ${(page - 1) * PER}`, params);
const now = new Date().toISOString();
const slotsLeft = await planFeaturedAvailable(db, dealer);
const used = await activeVehicleCount(db, dealer.id);
const featuredPrice = formatPrice(Number(s.featured_price_cents || 2900));
---
<DashboardLayout title="Inventory" area="dealer" err={err || null}>
  <div class="spread"><h1 style="margin:0">Inventory</h1><a class="btn btn-primary" href="/dashboard/vehicles/new">+ Add vehicle</a></div>
  <p class="muted">{used}/{plan.vehicleLimit} listings used · {slotsLeft} of {plan.featuredSlots} included featured slots available · Extra featured: {featuredPrice}/{s.featured_days || 30} days</p>
  <form method="get" class="toolbar">
    <div class="field"><label for="iq">Search</label><input class="input" id="iq" name="q" value={q} placeholder="Make, model, VIN or stock #" /></div>
    <div class="field"><label for="is">Status</label><select class="select" id="is" name="status"><option value="">All statuses</option>{['active', 'draft', 'sold', 'archived'].map((x) => <option value={x} selected={x === status}>{x}</option>)}</select></div>
    <button class="btn btn-outline" type="submit">Filter</button>
  </form>
  {rows.length === 0 ? (
    <EmptyState title={q || status ? 'No vehicles match your filters' : 'Your inventory is empty'}>
      <p>{q || status ? 'Try clearing the filters.' : 'Add your first vehicle to start receiving leads from Alabama shoppers.'}</p>
      <p><a class="btn btn-primary" href="/dashboard/vehicles/new">Add a vehicle</a></p>
    </EmptyState>
  ) : (
    <>
    <form method="post" id="bulk">
      <div class="toolbar">
        <div class="field" style="max-width:220px"><label for="bstatus">Bulk: set status</label>
          <select class="select" id="bstatus" name="status">{VEHICLE_STATUSES.map((st) => <option value={st.value}>{st.label}</option>)}</select></div>
        <button class="btn btn-outline" type="submit" name="action" value="bulk_status">Apply to selected</button>
        <button class="btn btn-danger" type="submit" name="action" value="bulk_delete" data-confirm-click="Delete the selected vehicles permanently?">Delete selected</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th><input type="checkbox" aria-label="Select all" data-select-all /></th><th>Vehicle</th><th>Price</th><th>Status</th><th>Views</th><th>Leads</th><th>Featured</th><th></th></tr></thead>
          <tbody>
            {rows.map((r) => {
              const featured = r.featured_until && r.featured_until > now;
              return (
                <tr>
                  <td><input type="checkbox" name="ids" value={r.id} aria-label={`Select ${r.year} ${r.make} ${r.model}`} /></td>
                  <td><div class="row" style="flex-wrap:nowrap">{r.img ? <img class="thumb" src={`/media/${r.img}`} alt="" loading="lazy" /> : <span class="thumb" aria-hidden="true"></span>}
                    <div><a href={`/dashboard/vehicles/${r.id}`}><strong>{r.year} {r.make} {r.model}</strong></a>{r.trim && <span class="muted"> {r.trim}</span>}<br /><span class="small muted">{formatNumber(r.mileage)} mi{r.stock_number ? ` · #${r.stock_number}` : ''}{!r.img ? ' · no photos' : ''}</span></div></div></td>
                  <td>{formatPrice(r.price_cents)}</td>
                  <td><span class={`badge ${r.status === 'active' ? 'badge-ok' : r.status === 'sold' ? 'badge-dark' : ''}`}>{r.status}</span></td>
                  <td>{r.views}</td>
                  <td>{r.leads}</td>
                  <td>{featured ? <span class="badge badge-featured">until {r.featured_until!.slice(0, 10)}</span> : <span class="muted small">—</span>}</td>
                  <td style="white-space:nowrap">
                    {r.status === 'active' && (featured
                      ? <button class="btn btn-ghost btn-sm" type="submit" form={`f-${r.id}`} name="action" value="unfeature">Unfeature</button>
                      : slotsLeft > 0
                        ? <button class="btn btn-ghost btn-sm" type="submit" form={`f-${r.id}`} name="action" value="feature">Feature (free slot)</button>
                        : <button class="btn btn-ghost btn-sm" type="submit" form={`f-${r.id}`} name="action" value="buy_featured">{stripeEnabled(env) ? `Feature · ${featuredPrice}` : 'Request featuring'}</button>)}
                    <a class="btn btn-ghost btn-sm" href={`/dashboard/vehicles/${r.id}`}>Edit</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </form>
    {rows.map((r) => <form method="post" id={`f-${r.id}`} hidden><input type="hidden" name="vehicle_id" value={r.id} /></form>)}
    <Pagination page={page} pages={Math.max(1, Math.ceil(total / PER))} href={(p) => `/dashboard/vehicles?${new URLSearchParams({ ...(q && { q }), ...(status && { status }), page: String(p) })}`} />
    </>
  )}
</DashboardLayout>
<script>
  document.querySelector<HTMLInputElement>('[data-select-all]')?.addEventListener('change', (e) => {
    const on = (e.target as HTMLInputElement).checked;
    document.querySelectorAll<HTMLInputElement>('input[name="ids"]').forEach((c) => (c.checked = on));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-confirm-click]').forEach((b) =>
    b.addEventListener('click', (e) => { if (!confirm(b.dataset.confirmClick!)) e.preventDefault(); }),
  );
</script>
