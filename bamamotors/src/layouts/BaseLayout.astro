---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { absolute } from '../lib/seo';
import { truncate } from '../lib/format';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string; // path; defaults to the current path without query
  noindex?: boolean;
  jsonLd?: unknown[];
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  published?: string | null;
  modified?: string | null;
  bodyClass?: string;
  bare?: boolean; // no header/footer (dashboards supply their own chrome)
  prev?: string | null;
  next?: string | null;
  ads?: boolean; // allow AdSense on this page (never on private/thin pages)
}

const env = Astro.locals.runtime.env;
const s = Astro.locals.settings ?? {};
const site = env.SITE_URL || Astro.site?.toString() || 'https://bamamotors.com';
const {
  title, description: rawDescription = s.default_meta_description, keywords = s.default_meta_keywords, canonical, noindex = false,
  jsonLd = [], ogImage, ogType = 'website', published, modified, bodyClass, bare = false, prev, next, ads = true,
} = Astro.props;
// Hard guarantee: meta descriptions never exceed 160 characters.
const description = truncate((rawDescription ?? '').replace(/\s+/g, ' ').trim(), 160);
const fullTitle = title.includes('BamaMotors') ? title : `${title} | BamaMotors`;
const canonicalUrl = absolute(site, canonical ?? Astro.url.pathname);
const image = ogImage ? (ogImage.startsWith('http') ? ogImage : absolute(site, ogImage)) : absolute(site, '/og-default.png');
const adsClient = s.adsense_client && /^ca-pub-\d{10,20}$/.test(s.adsense_client) ? s.adsense_client : '';
const showAds = Boolean(adsClient) && ads && !noindex && !bare;
const ga = s.ga4_id && /^G-[A-Z0-9]{4,12}$/.test(s.ga4_id) ? s.ga4_id : '';
---
<!doctype html>
<html lang="en-US" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalUrl} />
    {prev && <link rel="prev" href={absolute(site, prev)} />}
    {next && <link rel="next" href={absolute(site, next)} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="preload" href="/fonts/manrope-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2a4a" />
    <meta name="geo.region" content="US-AL" />
    <meta property="og:site_name" content="BamaMotors" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType === 'product' ? 'product' : ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {s.google_site_verification && <meta name="google-site-verification" content={s.google_site_verification} />}
    {adsClient && <meta name="google-adsense-account" content={adsClient} />}
    {showAds && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsClient}`} crossorigin="anonymous"></script>}
    {s.bing_site_verification && <meta name="msvalidate.01" content={s.bing_site_verification} />}
    {jsonLd.filter(Boolean).map((d) => <JsonLd data={d} />)}
    {ga && (
      <script is:inline define:vars={{ ga }}>
        window.dataLayer = window.dataLayer || [];
        // eslint-disable-next-line prefer-rest-params -- gtag requires the arguments object
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', ga, { anonymize_ip: true });
        addEventListener('load', function () {
          setTimeout(function () {
            const s = document.createElement('script'); s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga; document.head.appendChild(s);
          }, 2500);
        });
      </script>
    )}
  </head>
  <body class={bodyClass} data-auth={Astro.locals.user ? "1" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    {bare ? <slot /> : <main id="main"><slot /></main>}
    {!bare && <Footer />}
    <script>import '../scripts/effects';</script>
  </body>
</html>
