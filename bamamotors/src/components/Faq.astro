---
import type { Faq } from '../lib/markdown';
interface Props { faq: Faq[]; title?: string; id?: string; }
const { faq, title = 'Frequently asked questions', id = 'faq' } = Astro.props;
---
{faq.length > 0 && (
  <section class="faq" aria-labelledby={`${id}-title`}>
    <h2 id={`${id}-title`}>{title}</h2>
    {faq.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <div><p>{f.a}</p></div>
      </details>
    ))}
  </section>
)}
