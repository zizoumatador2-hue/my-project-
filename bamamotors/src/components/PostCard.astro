---
import type { PostCard } from '../lib/blog';
import { formatDate } from '../lib/format';
interface Props { p: PostCard; }
const { p } = Astro.props;
---
<article class="tile" style="position:relative">
  {p.category_name && <span class="badge" style="align-self:flex-start">{p.category_name}</span>}
  <h2 style="font-size:1.1rem;margin:6px 0 4px"><a href={`/blog/${p.slug}`} style="color:var(--ink);text-decoration:none">{p.title}</a></h2>
  <p class="small muted" style="margin:0 0 8px">{p.excerpt}</p>
  <p class="small muted" style="margin:auto 0 0">Updated <time datetime={p.updated_at}>{formatDate(p.updated_at)}</time></p>
</article>
