---
import { all } from '../lib/db';
import { BODY_TYPES, FUEL_TYPES, TRANSMISSIONS, DRIVETRAINS, COLORS, CONDITIONS, TITLE_STATUSES, VEHICLE_STATUSES } from '../lib/constants';
import type { FieldErrors } from '../lib/validation';

interface Props { values: Record<string, string>; errors: FieldErrors; submitLabel: string; dealers?: { id: number; name: string }[]; }
const { values, errors, submitLabel, dealers } = Astro.props;
const db = Astro.locals.runtime.env.DB;
const makes = await all<{ id: number; name: string }>(db, 'SELECT id, name FROM makes ORDER BY name');
const models = values.make_id ? await all<{ id: number; name: string; body_type: string | null }>(db, 'SELECT id, name, body_type FROM models WHERE make_id = ? ORDER BY name', [Number(values.make_id)]) : [];
const year = new Date().getFullYear() + 1;
const years = Array.from({ length: 50 }, (_, i) => year - i);
const val = (k: string) => values[k] ?? '';
const inv = (k: string) => (errors[k] ? 'true' : undefined);
---
<form method="post" novalidate data-vehicle-form>
  <input type="hidden" name="action" value="save" />
  {errors._ && <div class="alert alert-err" role="alert">{errors._}</div>}
  {Object.keys(errors).length > 0 && !errors._ && <div class="alert alert-err" role="alert">Please fix the highlighted fields.</div>}
  {dealers && (
    <fieldset><legend>Dealer</legend>
      <div class="field"><label for="v-dealer">Listing dealer</label>
        <select class="select" id="v-dealer" name="dealer_id" required>{dealers.map((d) => <option value={d.id} selected={String(d.id) === val('dealer_id')}>{d.name}</option>)}</select></div>
    </fieldset>
  )}
  <fieldset><legend>Vehicle</legend>
    <div class="form-grid">
      <div class="field"><label for="v-year">Year *</label><select class="select" id="v-year" name="year" required aria-invalid={inv('year')}>{years.map((y) => <option value={y} selected={String(y) === val('year')}>{y}</option>)}</select>{errors.year && <span class="field-error">{errors.year}</span>}</div>
      <div class="field"><label for="v-make">Make *</label><select class="select" id="v-make" name="make_id" required aria-invalid={inv('make_id')} data-make-id><option value="">Choose make</option>{makes.map((m) => <option value={m.id} selected={String(m.id) === val('make_id')}>{m.name}</option>)}</select>{errors.make_id && <span class="field-error">{errors.make_id}</span>}</div>
      <div class="field"><label for="v-model">Model *</label><select class="select" id="v-model" name="model_id" required aria-invalid={inv('model_id')} data-model-id><option value="">Choose model</option>{models.map((m) => <option value={m.id} data-body={m.body_type ?? ''} selected={String(m.id) === val('model_id')}>{m.name}</option>)}</select>{errors.model_id && <span class="field-error">{errors.model_id}</span>}</div>
      <div class="field"><label for="v-trim">Trim</label><input class="input" id="v-trim" name="trim" value={val('trim')} maxlength="60" placeholder="e.g. SE, XLT, EX-L" /></div>
      <div class="field"><label for="v-condition">Condition *</label><select class="select" id="v-condition" name="condition">{CONDITIONS.map((c) => <option value={c.value} selected={c.value === (val('condition') || 'used')}>{c.label}</option>)}</select></div>
      <div class="field"><label for="v-price">Price (USD) *</label><input class="input" id="v-price" name="price" inputmode="numeric" required value={val('price')} aria-invalid={inv('price')} placeholder="18995" />{errors.price && <span class="field-error">{errors.price}</span>}</div>
      <div class="field"><label for="v-mileage">Mileage *</label><input class="input" id="v-mileage" name="mileage" inputmode="numeric" required value={val('mileage')} aria-invalid={inv('mileage')} placeholder="54210" />{errors.mileage && <span class="field-error">{errors.mileage}</span>}</div>
      <div class="field"><label for="v-vin">VIN</label><input class="input" id="v-vin" name="vin" maxlength="17" value={val('vin')} aria-invalid={inv('vin')} style="text-transform:uppercase" />{errors.vin && <span class="field-error">{errors.vin}</span>}</div>
      <div class="field"><label for="v-stock">Stock #</label><input class="input" id="v-stock" name="stock_number" maxlength="40" value={val('stock_number')} /></div>
    </div>
  </fieldset>
  <fieldset><legend>Specifications</legend>
    <div class="form-grid">
      <div class="field"><label for="v-body">Body type *</label><select class="select" id="v-body" name="body_type" required aria-invalid={inv('body_type')} data-body><option value="">Choose</option>{BODY_TYPES.map((b) => <option selected={b.value === val('body_type')}>{b.value}</option>)}</select>{errors.body_type && <span class="field-error">{errors.body_type}</span>}</div>
      <div class="field"><label for="v-fuel">Fuel type *</label><select class="select" id="v-fuel" name="fuel_type">{FUEL_TYPES.map((f) => <option selected={f === (val('fuel_type') || 'Gasoline')}>{f}</option>)}</select></div>
      <div class="field"><label for="v-trans">Transmission *</label><select class="select" id="v-trans" name="transmission">{TRANSMISSIONS.map((f) => <option selected={f === (val('transmission') || 'Automatic')}>{f}</option>)}</select></div>
      <div class="field"><label for="v-drive">Drivetrain *</label><select class="select" id="v-drive" name="drivetrain">{DRIVETRAINS.map((f) => <option selected={f === (val('drivetrain') || 'FWD')}>{f}</option>)}</select></div>
      <div class="field"><label for="v-engine">Engine</label><input class="input" id="v-engine" name="engine" maxlength="80" value={val('engine')} placeholder="2.5L 4-cylinder" /></div>
      <div class="field"><label for="v-ext">Exterior color</label><select class="select" id="v-ext" name="exterior_color"><option value="">—</option>{COLORS.map((c) => <option selected={c === val('exterior_color')}>{c}</option>)}</select></div>
      <div class="field"><label for="v-int">Interior color</label><select class="select" id="v-int" name="interior_color"><option value="">—</option>{COLORS.map((c) => <option selected={c === val('interior_color')}>{c}</option>)}</select></div>
      <div class="field"><label for="v-mpgc">MPG city</label><input class="input" id="v-mpgc" name="mpg_city" inputmode="numeric" value={val('mpg_city')} /></div>
      <div class="field"><label for="v-mpgh">MPG highway</label><input class="input" id="v-mpgh" name="mpg_highway" inputmode="numeric" value={val('mpg_highway')} /></div>
    </div>
  </fieldset>
  <fieldset><legend>Description & features</legend>
    <div class="form-grid">
      <div class="field full"><label for="v-desc">Description</label><textarea class="textarea" id="v-desc" name="description" rows="6" maxlength="8000" aria-describedby="v-desc-hint">{val('description')}</textarea><span class="hint" id="v-desc-hint">Describe condition, recent service and what makes this vehicle a good buy. Write your own text. Don't copy from other websites.</span></div>
      <div class="field full"><label for="v-features">Features</label><textarea class="textarea" id="v-features" name="features" rows="4" aria-describedby="v-feat-hint">{val('features')}</textarea><span class="hint" id="v-feat-hint">One per line, e.g. Backup camera, Apple CarPlay, Heated seats.</span></div>
    </div>
  </fieldset>
  <fieldset><legend>Vehicle history (as disclosed by the dealer)</legend>
    <div class="form-grid">
      <div class="field"><label for="v-title">Title status</label><select class="select" id="v-title" name="title_status">{TITLE_STATUSES.map((t) => <option value={t.value} selected={t.value === (val('title_status') || 'unknown')}>{t.label}</option>)}</select></div>
      <div class="field"><label for="v-owners">Previous owners</label><input class="input" id="v-owners" name="owners" inputmode="numeric" value={val('owners')} /></div>
      <div class="field"><label for="v-acc">Accident-free</label><select class="select" id="v-acc" name="accident_free">{[['', 'Not disclosed'], ['1', 'Yes'], ['0', 'No']].map(([v, l]) => <option value={v} selected={v === val('accident_free')}>{l}</option>)}</select></div>
      <div class="field"><label for="v-svc">Service records</label><select class="select" id="v-svc" name="service_records">{[['', 'Not disclosed'], ['1', 'Available'], ['0', 'Not available']].map(([v, l]) => <option value={v} selected={v === val('service_records')}>{l}</option>)}</select></div>
      <div class="field full"><label for="v-report">History report URL</label><input class="input" id="v-report" name="history_report_url" type="url" value={val('history_report_url')} aria-invalid={inv('history_report_url')} placeholder="https://" />{errors.history_report_url && <span class="field-error">{errors.history_report_url}</span>}</div>
    </div>
  </fieldset>
  <fieldset><legend>Listing status</legend>
    <div class="field" style="max-width:320px"><label for="v-status">Status</label>
      <select class="select" id="v-status" name="status">{VEHICLE_STATUSES.map((st) => <option value={st.value} selected={st.value === (val('status') || 'active')}>{st.label}</option>)}</select></div>
  </fieldset>
  <div class="row"><button class="btn btn-primary btn-lg" type="submit">{submitLabel}</button><slot name="actions" /></div>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-vehicle-form]').forEach((form) => {
    const make = form.querySelector<HTMLSelectElement>('[data-make-id]')!;
    const model = form.querySelector<HTMLSelectElement>('[data-model-id]')!;
    const body = form.querySelector<HTMLSelectElement>('[data-body]')!;
    make.addEventListener('change', async () => {
      model.innerHTML = '<option value="">Choose model</option>';
      if (!make.value) return;
      const res = await fetch(`/api/models?make_id=${make.value}`);
      const d = (await res.json()) as { models: { id: number; name: string; body_type: string | null }[] };
      for (const m of d.models) { const o = new Option(m.name, String(m.id)); o.dataset.body = m.body_type ?? ''; model.add(o); }
    });
    model.addEventListener('change', () => {
      const b = model.selectedOptions[0]?.dataset.body;
      if (b && !body.value) body.value = b;
    });
  });
</script>
