{
  "name": "bamamotors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "./scripts/dev-server.sh",
    "serve:fresh": "./scripts/dev-server.sh --fresh",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run tests/unit",
    "test:api": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:seed:build": "node scripts/build-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply bamamotors-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bamamotors-db --remote",
    "brand:assets": "node scripts/brand-assets.mjs",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.18.2",
    "marked": "^18.0.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0",
    "zipcodes": "^8.0.0"
  }
}
