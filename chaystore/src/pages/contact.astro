---
import DocLayout from '../layouts/DocLayout.astro';
import { SITE } from '../lib/site';
---
<DocLayout title="Contact ChayStore" h1="Contact Us" description="Contact the ChayStore editorial team for corrections, questions, partnership requests and press inquiries." path="/contact/" updated="2026-10-04">
  <p>We read every message. The fastest way to reach the {SITE.author} is through our contact site.</p>
  <ul>
    <li><strong>Contact:</strong> <a href={SITE.contactUrl} rel="noopener">{SITE.contactLabel}</a></li>
    <li><strong>Corrections:</strong> include the page URL and the change you suggest.</li>
    <li><strong>Partnerships and press:</strong> tell us who you are and what you have in mind.</li>
  </ul>
  <p>We typically reply within a few business days. We cannot give medical advice. For health questions, please speak with a healthcare professional.</p>
</DocLayout>
