---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you are looking for could not be found." path="/404/" noindex>
  <div class="wrap" style="padding:5rem 0;max-width:var(--prose)">
    <h1>Page not found</h1>
    <p>That page has wandered off. Try the <a href="/guides/">guides index</a>, the <a href="/search/">search page</a> or go back to the <a href="/">home page</a>.</p>
  </div>
</BaseLayout>
