# Local secrets for `npm run preview` (wrangler pages dev). Copy to .dev.vars — never commit .dev.vars.
SITE_URL=http://localhost:8788
IP_HASH_SALT=replace-with-a-long-random-string
# Email delivery (https://resend.com). Required for newsletter confirmations.
RESEND_API_KEY=
EMAIL_FROM="Fountain Finances <newsletter@fountainfinances.com>"
CONTACT_TO_EMAIL=info.christopherkunz@gmail.com
# Optional bot protection (Cloudflare Turnstile). Set together with PUBLIC_TURNSTILE_SITE_KEY at build time.
TURNSTILE_SECRET_KEY=
