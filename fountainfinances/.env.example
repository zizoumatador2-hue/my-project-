# Build-time public variables (safe to expose in HTML). Copy to .env for local builds.
# Google Analytics 4 measurement ID — analytics loads only after a visitor consents.
PUBLIC_GA_ID=
# Search engine verification tokens
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=
# Cloudflare Turnstile site key (optional; pair with TURNSTILE_SECRET_KEY)
PUBLIC_TURNSTILE_SITE_KEY=
# Google AdSense publisher id (ca-pub-…): loads Auto ads and writes ads.txt
PUBLIC_ADSENSE_CLIENT=
