---
import PageHead from '@/components/PageHead.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Disclosure from '@/components/Disclosure.astro';
import { hubBySlug } from '@/data/taxonomy';
import { collectionPage, itemList } from '@/lib/schema';

const items = await getCollection('comparisons');
const path = '/best/';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Comparisons', href: path }];
const title = 'Compare Financial Products: Savings, Cards, Loans & CDs';
const description = 'Side-by-side comparisons of savings, checking, CDs, credit cards and personal loans, with a transparent methodology and clearly labeled affiliate links.';
---
<BaseLayout title={title} description={description} keywords={['credit card comparison', 'savings account comparison', 'personal loan comparison', 'checking account comparison']} crumbs={crumbs} schema={[collectionPage({ url: path, name: title, description }), itemList('Product comparisons', items.map((c) => ({ name: c.data.title, url: `/best/${c.id}/` })))]}>
  <PageHead photo="best">
      <Breadcrumbs items={crumbs} />
      <h1>Compare Financial Products</h1>
      <p class="lede">Transparent, side-by-side comparisons of widely available U.S. financial products — with the criteria we use and the trade-offs of each option spelled out.</p>
  </PageHead>
  <div class="wrap" style="padding-top:28px;padding-bottom:56px">
    <Disclosure kind="comparison" />
    <div class="grid grid-3">
      {items.map((c) => (
        <article class="card">
          <div class="kicker">{hubBySlug(c.data.hub)?.shortTitle}</div>
          <h2><a href={`/best/${c.id}/`}>{c.data.title}</a></h2>
          <p>{c.data.description}</p>
        </article>
      ))}
    </div>
    <div class="prose" style="margin-top:40px">
      <h2>How our comparisons work</h2>
      <p>Each comparison explains the criteria that matter for that product type, then lists qualifying options alphabetically with their features, pros, cons and requirements. We do not publish a rate, fee or bonus unless an editor has confirmed it on the provider’s own website and recorded the date — financial terms change too often for anything else to be reliable.</p>
      <p>Learn more in our <a href="/editorial-standards/">editorial standards and methodology</a>.</p>

      <h2>How to choose the right product</h2>
      <p>The “best” account or card is the one that fits how you actually use money. Before comparing options, answer three questions:</p>
      <ol>
        <li><strong>What job does the product need to do?</strong> An emergency fund needs instant access and FDIC or NCUA insurance; money you won’t touch for a few years may earn more in a <a href="/guides/cd-ladder/">CD ladder</a>; a first credit card should help you <a href="/guides/how-to-build-credit/">build credit</a> without an annual fee.</li>
        <li><strong>What will it cost you?</strong> Look past the headline number. For savings, compare the <a href="/guides/what-is-apy/">APY</a> and any balance requirements. For borrowing, compare the <a href="/guides/what-is-apr/">APR</a>, fees and the total cost over the life of the loan — our <a href="/calculators/loan/">loan calculator</a> shows it.</li>
        <li><strong>Do you qualify?</strong> Credit requirements, minimum deposits and membership rules vary. Use prequalification tools, which rely on a <a href="/guides/hard-vs-soft-credit-inquiry/">soft credit check</a>, before you apply.</li>
      </ol>

      <h2>What to check on the provider’s site before you apply</h2>
      <ul>
        <li>The current rate and whether it is promotional or tied to conditions such as direct deposit.</li>
        <li>Every fee: monthly maintenance, overdraft, early withdrawal, balance transfer, origination and late fees.</li>
        <li>Deposit insurance (FDIC for banks, NCUA for credit unions) and the exact legal name of the insured institution.</li>
        <li>How you can reach customer service, and whether the app and website have the features you need.</li>
      </ul>
      <p>We list options alphabetically rather than ranking them, so you can weigh the trade-offs that matter to you. If a provider changes its terms or you spot something out of date, please <a href="/contact/">let us know</a> — we correct errors promptly under our <a href="/corrections/">corrections policy</a>.</p>
    </div>
  </div>
</BaseLayout>
