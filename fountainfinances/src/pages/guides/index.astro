---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import GuideCard from '@/components/GuideCard.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import { HUBS } from '@/data/taxonomy';
import { collectionPage, itemList } from '@/lib/schema';

const guides = (await getCollection('guides', (g) => !g.data.draft)).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
const path = '/guides/';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guides', href: path }];
const title = 'Personal Finance Guides: Budgeting, Credit, Loans & More';
const description = 'In-depth, sourced personal finance guides in plain English: budgeting, saving, credit scores, credit cards, bank accounts, loans, mortgages and insurance.';
---
<BaseLayout title={title} description={description} keywords={['personal finance guide', 'personal finance for beginners', 'financial advice for beginners', 'money management advice']} crumbs={crumbs} schema={[collectionPage({ url: path, name: title, description }), itemList('Guides', guides.map((g) => ({ name: g.data.title, url: `/guides/${g.id}/` })))]}>
  <div class="page-head">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Personal Finance Guides</h1>
      <p class="lede">Clear, carefully sourced explanations of the money decisions most Americans face — from building a first budget to buying a home.</p>
    </div>
  </div>
  <div class="wrap" style="padding-top:12px">
    <nav aria-label="Jump to a topic" style="padding:20px 0 4px">
      <ul class="pill-list">{HUBS.map((h) => <li><a href={`#${h.slug}`}>{h.shortTitle}</a></li>)}</ul>
    </nav>
    {HUBS.map((h) => {
      const list = guides.filter((g) => g.data.hub === h.slug);
      return list.length > 0 && (
        <section class="section" style="padding:28px 0" aria-labelledby={h.slug}>
          <div class="section-head"><h2 id={h.slug}>{h.title}</h2><a class="more" href={`/${h.slug}/`}>{h.shortTitle} hub →</a></div>
          <div class="grid grid-3">{list.map((g) => <GuideCard slug={g.id} title={g.data.title} description={g.data.description} updated={g.data.updated} />)}</div>
        </section>
      );
    })}
  </div>
  <div class="wrap" style="padding:32px 16px 56px"><NewsletterForm placement="guides" /></div>
</BaseLayout>
