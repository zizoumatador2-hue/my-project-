---
interface Props { sources: { title: string; publisher: string; url: string }[] }
const { sources } = Astro.props;
---
{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-h">
    <h2 id="sources-h">Sources</h2>
    <ol>
      {sources.map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a>: {s.publisher}</li>
      ))}
    </ol>
  </section>
)}
