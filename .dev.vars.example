# Local development only. Copy to .dev.vars. NEVER use these values in production.
ENVIRONMENT=development
PAYMENT_PROVIDER=sandbox
APP_URL=http://localhost:8787
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# Sandbox provider signs its simulated webhooks with this, exercising the same verification path as Stripe.
STRIPE_WEBHOOK_SECRET=whsec_dev_local_only
BOOTSTRAP_ADMIN_EMAIL=admin@trusttransfer.test
