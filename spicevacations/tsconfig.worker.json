{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "vitest/globals"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "worker/**/*.ts",
    "src/lib/planner-core.ts",
    "src/lib/validation.ts",
    "tests/worker.test.ts"
  ]
}
