# ---- Build-time (Astro) ----
# Canonical origin used for canonicals, sitemap and Open Graph URLs.
SITE_URL=https://spicevacations.com
# Optional analytics. Loaded ONLY after the visitor accepts analytics cookies.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_GA4_ID=

# ---- Worker runtime (wrangler secret put / .dev.vars) ----
# Planner: "rules" (default, no API cost) or "llm" (uses Claude via the Anthropic API).
PLANNER_PROVIDER=rules
PLANNER_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Contact form forwarding (optional; messages are always stored in KV).
RESEND_API_KEY=
CONTACT_TO=info.christopherkunz@gmail.com
CONTACT_FROM=SpiceVacations <hello@spicevacations.com>
# Optional Cloudflare Turnstile on forms.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
