---
import Icon from './Icon.astro';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside class="disclosure" aria-label="Affiliate disclosure">
  <Icon name="info" />
  <p class="mb-0">
    {
      compact ? (
        <>
          We may earn a commission when you book through our links, at no extra cost to you. Prices and availability are set by the provider.{' '}
          Read our <a href="/affiliate-disclosure/">affiliate disclosure</a>.
        </>
      ) : (
        <>
          <strong>Transparency first.</strong> SpiceVacations.com is an independent publisher, not a hotel, airline, cruise line or travel agency. Some
          links are affiliate links: if you book through them we may earn a commission at no extra cost to you. Final prices, availability and terms
          are always set by the provider you book with. <a href="/affiliate-disclosure/">How we make money</a>.
        </>
      )
    }
  </p>
</aside>
