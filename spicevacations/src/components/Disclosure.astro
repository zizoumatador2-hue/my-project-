---
import Icon from './Icon.astro';
interface Props {
  /** Compact inline disclosures were removed at the owner's request; the footer disclosure and the
      /affiliate-disclosure/ page still cover every affiliate link. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

{
  !compact && (
    <aside class="disclosure" aria-label="Affiliate disclosure">
      <Icon name="info" />
      <p class="mb-0">
        <strong>Transparency first.</strong> SpiceVacations.com is an independent publisher, not a hotel, airline, cruise line or travel agency. Some
        links are affiliate links: if you book through them we may earn a commission at no extra cost to you. Final prices, availability and terms are
        always set by the provider you book with. <a href="/affiliate-disclosure/">How we make money</a>.
      </p>
    </aside>
  )
}
