---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ResortCard from '../../components/ResortCard.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import FaqList from '../../components/FaqList.astro';
import Disclosure from '../../components/Disclosure.astro';
import PartnerSlot from '../../components/PartnerSlot.astro';
import Icon from '../../components/Icon.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getGuides, lookup, url, readingTime, fmtDate, destinationTarget } from '../../lib/content';
import { article, breadcrumbList, faqPage, howTo, webPage } from '../../lib/schema';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}

const { g } = Astro.props as { g: Awaited<ReturnType<typeof getGuides>>[number] };
const { Content, headings } = await render(g);
const L = await lookup();
const d = g.data;
const path = url.guide(g.id);
const { words, minutes } = readingTime(g.body);
const category = L.vacationTypes.get(d.category);
const resorts = d.resorts.map((id) => L.resorts.get(id)).filter((x): x is NonNullable<typeof x> => Boolean(x));
const dests = d.destinations.map((id) => L.destinations.get(id)).filter((x): x is NonNullable<typeof x> => Boolean(x));
const allGuides = [...L.guides.values()];
const relatedIds = [...d.related, ...allGuides.filter((x) => x.id !== g.id && x.data.category === d.category).map((x) => x.id)];
const related = [...new Set(relatedIds)]
  .filter((id) => id !== g.id)
  .map((id) => L.guides.get(id))
  .filter((x): x is NonNullable<typeof x> => Boolean(x))
  .slice(0, 3);
const toc = headings.filter((h) => h.depth === 2);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/guides/' },
  ...(category ? [{ name: category.data.name, href: url.vacationType(category.id) }] : []),
  { name: d.title, href: path },
];
const image = d.image || `/og/${path.replace(/^\/|\/$/g, '').replace(/\//g, '--')}.png`;
const schema = [
  webPage({ path, title: d.metaTitle, description: d.metaDescription }),
  breadcrumbList(crumbs),
  article({ path, title: d.title, description: d.metaDescription, image, published: d.published, updated: d.updated, words, keywords: [d.primaryKeyword, ...d.secondaryKeywords], section: category?.data.name ?? 'Travel guides' }),
  faqPage(d.faqs, path),
  d.howTo ? howTo(d.howTo, path) : null,
];
const primaryDest = dests[0];
---

<Base title={d.metaTitle} description={d.metaDescription} ogType="article" noindex={d.noindex} canonical={d.canonical} schema={schema}>
  <PageHero title={d.title} crumbs={crumbs} media={d} pkey={`guides/${g.id}`} eyebrow={category?.data.name ?? 'Travel guide'}>
    <div class="meta-row">
      <span>By the SpiceVacations Editorial Team</span>
      <span>Updated <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></span>
      <span>{minutes} min read</span>
    </div>
  </PageHero>

  <div class="container section--tight">
    <div class="article-layout">
      <article>
        <div class="snippet" data-reveal>
          <p>{d.snippet}</p>
        </div>

        <div class="mt-3"><Disclosure compact /></div>

        <div class="prose mt-4">
          <Content />
        </div>

        <AdSlot />

        {
          d.howTo && (
            <section class="mt-4 info-card" aria-labelledby="howto">
              <h2 id="howto">{d.howTo.name}</h2>
              <p class="muted small">
                <Icon name="clock" size={16} class="inline-icon" /> Estimated planning time: {d.howTo.totalTime.replace('PT', '').replace('H', ' hours').replace('M', ' minutes')}
              </p>
              <ol class="steps">
                {d.howTo.steps.map((s, i) => (
                  <li id={`step-${i + 1}`}>
                    <strong>{s.name}.</strong> {s.text}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          resorts.length > 0 && (
            <section class="mt-4" aria-labelledby="resorts-in-guide">
              <h2 id="resorts-in-guide">Resorts mentioned in this guide</h2>
              <p class="muted">Tap a resort for details, or check live availability with our partners. Prices vary and are set by the provider.</p>
              <div class="grid grid-2 mt-2" data-stagger>
                {resorts.map((r) => (
                  <ResortCard r={r} destinationName={L.destinations.get(r.data.destination)?.data.name ?? ''} placement={`guide-${g.id}`} />
                ))}
              </div>
            </section>
          )
        }

        <FaqList faqs={d.faqs} />

        <section class="mt-4 info-card" aria-labelledby="pillar-link">
          <h2 id="pillar-link">Keep planning</h2>
          <p class="mb-0">
            This guide is part of our complete <a href="/">romantic getaways guide</a>, which covers how to choose a destination, set a budget and plan
            the perfect trip for two{category && <> Explore more <a href={url.vacationType(category.id)}>{category.data.name.toLowerCase()}</a></>}.
          </p>
        </section>
      </article>

      <aside class="article-aside" aria-label="In this guide">
        {
          toc.length > 2 && (
            <nav class="toc" aria-labelledby="toc-title">
              <h2 id="toc-title">In this guide</h2>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          primaryDest && (
            <div class="mt-3">
              <PartnerSlot
                target={destinationTarget(primaryDest, 'hotel', '/plan-my-vacation/')}
                heading={`Stays in ${primaryDest.data.name}`}
                text="Compare hotels and resorts for your dates. Final prices and availability are set by the provider."
                placement={`guide-aside-${g.id}`}
              />
            </div>
          )
        }
        <div class="info-card mt-3">
          <h2>Not sure where to go?</h2>
          <p class="small muted">Tell us your budget, dates and style and get a shortlist in seconds.</p>
          <a class="btn btn--sm btn--block" href="/plan-my-vacation/">Plan my vacation</a>
        </div>
      </aside>
    </div>
  </div>

  {
    dests.length > 0 && (
      <section class="section section--white">
        <div class="container">
          <h2 data-reveal>Destinations in this guide</h2>
          <div class="grid grid-3 mt-3" data-stagger>
            {dests.map((x) => (
              <DestinationCard d={x} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 data-reveal>Related guides</h2>
          <div class="grid grid-3 mt-3" data-stagger>
            {related.map((x) => (
              <GuideCard g={x} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <NewsletterBand />
</Base>

<style>
  .steps {
    padding-left: 1.3em;
    display: grid;
    gap: 12px;
  }
  .steps li::marker {
    color: var(--coral-text);
    font-weight: 800;
  }
  .info-card :global(.inline-icon) {
    display: inline;
    vertical-align: -3px;
  }
</style>
