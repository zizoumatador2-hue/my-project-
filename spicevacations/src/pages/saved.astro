---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { breadcrumbList, webPage } from '../lib/schema';
const path = '/saved/';
const title = 'Your Saved Trips | SpiceVacations';
const description = 'The destinations, resorts and deals you saved on SpiceVacations. Saved trips stay on this device only, so nothing is shared or stored on our servers.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Saved trips', href: path }];
---

<Base title={title} description={description} noindex schema={[webPage({ path, title, description }), breadcrumbList(crumbs)]}>
  <PageHero title="Your saved trips" crumbs={crumbs} lead="Tap the heart on any destination, resort or deal to save it here. Saved trips are stored on this device only." />
  <div class="container section">
    <div class="grid grid-3" data-saved-list></div>
    <div class="empty-state" data-saved-empty hidden>
      <h2>Nothing saved yet</h2>
      <p>Start with our favorite <a href="/destinations/">destinations</a>, <a href="/resorts/">resorts for couples</a> or <a href="/deals/">deal timing</a>.</p>
    </div>
  </div>
</Base>

<script>
  import { getSaved } from '../scripts/main';
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const list = document.querySelector<HTMLElement>('[data-saved-list]')!;
  const empty = document.querySelector<HTMLElement>('[data-saved-empty]')!;
  function draw() {
    const saved = getSaved().filter((s) => s.href.startsWith('/'));
    empty.hidden = saved.length > 0;
    list.innerHTML = saved
      .map(
        (s) => `<article class="card"><div class="card__media"><img src="${esc(s.img?.startsWith('/') ? s.img : '/art/beach-coral.svg')}" alt="" width="1600" height="1000" loading="lazy">
        <button class="save-btn" type="button" aria-pressed="true" data-save="${esc(s.id)}" data-title="${esc(s.title)}" data-href="${esc(s.href)}" data-img="${esc(s.img || '')}" data-kind="${esc(s.kind || '')}" aria-label="Remove ${esc(s.title)}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button></div>
        <div class="card__body"><p class="card__kicker">${esc(s.kind || 'Saved')}</p><h2 class="card__title"><a href="${esc(s.href)}">${esc(s.title)}</a></h2></div></article>`,
      )
      .join('');
  }
  document.addEventListener('saved:change', draw);
  draw();
</script>
