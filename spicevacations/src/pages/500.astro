---
import Base from '../layouts/Base.astro';
---

<Base title="Something Went Wrong | SpiceVacations" description="Something went wrong on our side. Please try again in a moment, or keep exploring romantic getaways, destinations and resorts on SpiceVacations.com." noindex>
  <section class="page-hero page-hero--plain">
    <div class="container center">
      <p class="eyebrow" style="color:var(--gold)">Error 500</p>
      <h1>We hit some turbulence</h1>
      <p class="lead" style="margin-inline:auto">Something went wrong on our side. Please try again in a moment.</p>
      <div class="cluster mt-3" style="justify-content:center">
        <a class="btn" href="/">Back to home</a>
        <a class="btn btn--light" href="/contact/">Report a problem</a>
      </div>
    </div>
  </section>
</Base>
